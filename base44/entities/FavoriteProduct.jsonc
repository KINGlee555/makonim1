    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 \u05d4\u05de\u05d5\u05e2\u05d3\u05e3"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string",

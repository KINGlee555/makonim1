{
  "name": "DeliveryRequest",
  "type": "object",
  "properties": {
    "list_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05d9\u05de\u05d4 \u05e9\u05de\u05de\u05e0\u05d4 \u05d4\u05d5\u05d6\u05de\u05df \u05d4\u05de\u05e9\u05dc\u05d5\u05d7"
    },
    "requested_by": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05ea\u05e3 \u05e9\u05d1\u05d9\u05e7\u05e9 \u05d0\u05ea \u05d4\u05de\u05e9\u05dc\u05d5\u05d7"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8 \u05e2\u05dd \u05d4\u05de\u05d6\u05de\u05d9\u05df"
    },
    "address": {
      "type": "string",
      "maxLength": 120,
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d4\u05de\u05e9\u05dc\u05d5\u05d7"
    },
    "note": {
      "type": "string",
      "maxLength": 160,
      "default": "",
      "description": "\u05d4\u05e2\u05e8\u05d4 \u05dc\u05e9\u05dc\u05d9\u05d7"
    },
    "total_weight_kg": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e9\u05e7\u05dc \u05d4\u05de\u05e9\u05dc\u05d5\u05d7 \u05d1\u05e7\u05d9\u05dc\u05d5\u05d2\u05e8\u05de\u05d9\u05dd (\u05e2\u05d3 12)"
    },
    "items_count": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05d1\u05de\u05e9\u05dc\u05d5\u05d7"
    },
    "message": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e1\u05d7 \u05d4\u05d1\u05e7\u05e9\u05d4 \u05e9\u05e0\u05e9\u05dc\u05d7 \u05dc\u05e9\u05dc\u05d9\u05d7"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "done",
        "cancelled"
      ],
      "default": "open",
      "description": "\u05de\u05e6\u05d1 \u05d1\u05e7\u05e9\u05ea \u05d4\u05de\u05e9\u05dc\u05d5\u05d7"
    }
  },
  "required": [
    "list_id"
  ]
}
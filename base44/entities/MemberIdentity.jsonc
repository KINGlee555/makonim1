{
  "name": "MemberIdentity",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 64,
      "description": "\u05d4\u05e9\u05dd \u05e9\u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e0\u05e8\u05e9\u05dd \u05d0\u05d9\u05ea\u05d5 \u2014 \u05d4\u05d6\u05d4\u05d5\u05ea \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05e9\u05dc\u05d5 \u05d1\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4"
    },
    "name_key": {
      "type": "string",
      "description": "\u05d4\u05e9\u05dd \u05d4\u05de\u05e0\u05d5\u05e8\u05de\u05dc (\u05d0\u05d5\u05ea\u05d9\u05d5\u05ea \u05e7\u05d8\u05e0\u05d5\u05ea, \u05d1\u05dc\u05d9 \u05e8\u05d5\u05d5\u05d7\u05d9\u05dd \u05db\u05e4\u05d5\u05dc\u05d9\u05dd) \u2014 \u05dc\u05e4\u05d9 \u05d6\u05d4 \u05e0\u05e7\u05d1\u05e2 \u05d0\u05dd \u05d4\u05e9\u05dd \u05ea\u05e4\u05d5\u05e1"
    },
    "email": {
      "type": "string",
      "default": "",
      "description": "\u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05de\u05e1\u05e0\u05db\u05e8\u05df \u05d0\u05ea \u05d4\u05e9\u05dd \u05d1\u05d9\u05df \u05d4\u05de\u05db\u05e9\u05d9\u05e8\u05d9\u05dd"
    },
    "phone": {
      "type": "string",
      "default": "",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea \u05d1\u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4 (\u05d1\u05e4\u05d5\u05e8\u05de\u05d8 972...)"
    },
    "list_id": {
      "type": "string",
      "description": "\u05d4\u05e8\u05e9\u05d9\u05de\u05d4 \u05e9\u05d4\u05e9\u05dd \u05d4\u05d6\u05d4 \u05de\u05e9\u05d5\u05d9\u05da \u05d0\u05dc\u05d9\u05d4 \u2014 \u05ea\u05de\u05d9\u05d3 \u05d7\u05d5\u05d6\u05e8\u05d9\u05dd \u05d0\u05dc\u05d9\u05d4"
    },
    "list_title": {
      "type": "string",
      "default": "",
      "description": "\u05e9\u05dd \u05d4\u05e8\u05e9\u05d9\u05de\u05d4 \u05e9\u05d0\u05dc\u05d9\u05d4 \u05d4\u05e9\u05dd \u05de\u05e9\u05d5\u05d9\u05da"
    },
    "extra_list_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u05e8\u05e9\u05d9\u05de\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea \u05e9\u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d0\u05d9\u05e9\u05e8 \u05d1\u05de\u05e4\u05d5\u05e8\u05e9 \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05d0\u05ea \u05d4\u05e9\u05dd \u05d0\u05dc\u05d9\u05d4\u05df"
    },
    "whatsapp_reminders": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d9\u05e7\u05e9 \u05dc\u05e7\u05d1\u05dc \u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea \u05e7\u05e0\u05d9\u05d9\u05d4 \u05d1\u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4"
    }
  },
  "required": [
    "name",
    "name_key"
  ]
}
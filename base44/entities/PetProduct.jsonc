{
  "name": "PetProduct",
  "type": "object",
  "properties": {
    "store": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d7\u05e0\u05d5\u05ea (anipet, jungle)"
    },
    "store_name": {
      "type": "string",
      "default": "",
      "description": "\u05e9\u05dd \u05d4\u05d7\u05e0\u05d5\u05ea \u05dc\u05d4\u05e6\u05d2\u05d4"
    },
    "product_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d5\u05e6\u05e8 \u05d1\u05d7\u05e0\u05d5\u05ea \u2014 \u05db\u05d3\u05d9 \u05dc\u05d0 \u05dc\u05d9\u05e6\u05d5\u05e8 \u05db\u05e4\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05d1\u05d8\u05e2\u05d9\u05e0\u05d4 \u05d7\u05d5\u05d6\u05e8\u05ea"
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 \u05db\u05de\u05d5 \u05e9\u05d4\u05d5\u05d0 \u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05d7\u05e0\u05d5\u05ea"
    },
    "brand": {
      "type": "string",
      "default": "",
      "description": "\u05de\u05d5\u05ea\u05d2/\u05d9\u05e6\u05e8\u05df"
    },
    "category": {
      "type": "string",
      "default": "\u05d7\u05d9\u05d5\u05ea \u05de\u05d7\u05de\u05d3",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d1\u05e8\u05e9\u05d9\u05de\u05d4"
    },
    "size_label": {
      "type": "string",
      "default": "",
      "description": "\u05d4\u05de\u05e9\u05e7\u05dc \u05d0\u05d5 \u05d4\u05e0\u05e4\u05d7 \u05e9\u05d6\u05d5\u05d4\u05d5 \u05d1\u05e9\u05dd (\u05dc\u05de\u05e9\u05dc 8 \u05e7\"\u05d2), \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9 \u05e9\u05e7\u05d9 \u05de\u05d6\u05d5\u05df \u05d2\u05d3\u05d5\u05dc\u05d9\u05dd"
    },
    "price": {
      "type": "number",
      "default": 0,
      "description": "\u05d4\u05de\u05d7\u05d9\u05e8 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9 \u05d1\u05d7\u05e0\u05d5\u05ea"
    },
    "was_price": {
      "type": "number",
      "default": 0,
      "description": "\u05d4\u05de\u05d7\u05d9\u05e8 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05de\u05d1\u05e6\u05e2 (0 = \u05d0\u05d9\u05df \u05de\u05d1\u05e6\u05e2)"
    },
    "discount_pct": {
      "type": "number",
      "default": 0,
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05d4\u05e0\u05d7\u05d4"
    },
    "image_url": {
      "type": "string",
      "default": "",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05d5\u05e6\u05e8 \u05d4\u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05de\u05d4\u05d7\u05e0\u05d5\u05ea"
    },
    "url": {
      "type": "string",
      "default": "",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e2\u05de\u05d5\u05d3 \u05d4\u05de\u05d5\u05e6\u05e8 \u05d1\u05d7\u05e0\u05d5\u05ea"
    },
    "barcode": {
      "type": "string",
      "default": "",
      "description": "\u05d1\u05e8\u05e7\u05d5\u05d3 \u05d4\u05de\u05d5\u05e6\u05e8, \u05db\u05e9\u05d4\u05d7\u05e0\u05d5\u05ea \u05de\u05e1\u05e4\u05e7\u05ea \u05d0\u05d5\u05ea\u05d5"
    },
    "available": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 \u05d6\u05de\u05d9\u05df \u05db\u05e8\u05d2\u05e2"
    }
  },
  "required": [
    "store",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
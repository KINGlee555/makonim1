{
  "name": "ChainDeal",
  "type": "object",
  "properties": {
    "chain": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05ea (shufersal, rami_levy, ...)"
    },
    "barcode": {
      "type": "string",
      "description": "\u05d1\u05e8\u05e7\u05d5\u05d3 \u05d4\u05de\u05d5\u05e6\u05e8 \u05e9\u05e0\u05de\u05e6\u05d0 \u05d1\u05de\u05d1\u05e6\u05e2"
    },
    "name": {
      "type": "string",
      "default": "",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 \u05db\u05e4\u05d9 \u05e9\u05e0\u05e9\u05d0\u05dc"
    },
    "price": {
      "type": "number",
      "default": 0,
      "description": "\u05d4\u05de\u05d7\u05d9\u05e8 \u05d4\u05e8\u05d2\u05d9\u05dc \u05dc\u05e4\u05e0\u05d9 \u05d4\u05de\u05d1\u05e6\u05e2 (0 = \u05dc\u05d0 \u05d9\u05d3\u05d5\u05e2)"
    },
    "deal_price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05d4\u05de\u05d1\u05e6\u05e2 \u05d1\u05e9\u05e7\u05dc\u05d9\u05dd (0 = \u05d4\u05e0\u05d7\u05d4 \u05d1\u05d0\u05d7\u05d5\u05d6\u05d9\u05dd)"
    },
    "discount_rate": {
      "type": "number",
      "default": 0,
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05d4\u05e0\u05d7\u05d4 \u05db\u05e9\u05d4\u05d5\u05d0 \u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05de\u05e4\u05d5\u05e8\u05e9 \u05d1\u05de\u05e1\u05de\u05da \u05d4\u05e8\u05e9\u05ea"
    },
    "description": {
      "type": "string",
      "default": "",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05de\u05d1\u05e6\u05e2 \u05de\u05d4\u05e8\u05e9\u05ea"
    },
    "ends_on": {
      "type": "string",
      "default": "",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05d4\u05de\u05d1\u05e6\u05e2 (YYYY-MM-DD)"
    },
    "day": {
      "type": "string",
      "description": "\u05d4\u05d9\u05d5\u05dd \u05e9\u05d1\u05d5 \u05e0\u05d8\u05e2\u05df \u05d4\u05de\u05d1\u05e6\u05e2 (YYYY-MM-DD)"
    }
  },
  "required": [
    "chain",
    "barcode",
    "day"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
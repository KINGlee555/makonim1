{
  "name": "CatalogImage",
  "type": "object",
  "properties": {
    "barcode": {
      "type": "string",
      "description": "\u05d1\u05e8\u05e7\u05d5\u05d3 \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05d5\u05e6\u05e8 \u05e9\u05e0\u05de\u05e6\u05d0\u05d4 \u05dc\u05d1\u05e8\u05e7\u05d5\u05d3 (\u05e8\u05d9\u05e7 = \u05e2\u05d3\u05d9\u05d9\u05df \u05dc\u05d0 \u05e0\u05de\u05e6\u05d0\u05d4 \u05ea\u05de\u05d5\u05e0\u05d4)",
      "default": ""
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05d1\u05e8\u05e7\u05d5\u05d3 \u05e0\u05d1\u05d3\u05e7 \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05de\u05d5\u05dc \u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05ea\u05de\u05d5\u05e0\u05d5\u05ea"
    },
    "chain_checked": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d1\u05e8\u05e7\u05d5\u05d3 \u05e0\u05d1\u05d3\u05e7 \u05de\u05d5\u05dc \u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05d4\u05e8\u05e9\u05ea\u05d5\u05ea (\u05e8\u05de\u05d9 \u05dc\u05d5\u05d9)",
      "default": false
    },
    "name_checked": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d1\u05e8\u05e7\u05d5\u05d3 \u05e0\u05d1\u05d3\u05e7 \u05d2\u05dd \u05d1\u05d7\u05d9\u05e4\u05d5\u05e9 \u05dc\u05e4\u05d9 \u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8",
      "default": false
    }
  },
  "required": [
    "barcode"
  ]
}
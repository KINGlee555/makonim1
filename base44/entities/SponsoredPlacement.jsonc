{
  "name": "SponsoredPlacement",
  "type": "object",
  "properties": {
    "chain_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e8\u05e9\u05ea \u05e9\u05e7\u05e0\u05ea\u05d4 \u05d0\u05ea \u05d4\u05de\u05e7\u05d5\u05dd \u05d4\u05de\u05de\u05d5\u05de\u05df"
    },
    "headline": {
      "type": "string",
      "maxLength": 60,
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05e4\u05e8\u05e1\u05d5\u05de\u05ea"
    },
    "body": {
      "type": "string",
      "maxLength": 90,
      "default": "",
      "description": "\u05e9\u05d5\u05e8\u05ea \u05d4\u05e1\u05d1\u05e8 \u05e7\u05e6\u05e8\u05d4"
    },
    "url": {
      "type": "string",
      "description": "\u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05d4\u05e4\u05e8\u05e1\u05d5\u05de\u05ea \u05de\u05d5\u05d1\u05d9\u05dc\u05d4"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e7\u05d5\u05dd \u05d4\u05de\u05de\u05d5\u05de\u05df \u05de\u05d5\u05e6\u05d2 \u05db\u05e8\u05d2\u05e2"
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea \u05ea\u05e6\u05d5\u05d2\u05d4 \u2014 \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05de\u05d5\u05e6\u05d2 \u05e8\u05d0\u05e9\u05d5\u05df"
    }
  },
  "required": [
    "chain_name",
    "headline",
    "url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
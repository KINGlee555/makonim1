{
  "name": "OpenCatalogSync",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d0\u05d2\u05e8 \u05d4\u05e4\u05ea\u05d5\u05d7 (open_food_facts, open_beauty_facts, open_pet_food_facts, open_products_facts)"
    },
    "next_page": {
      "type": "number",
      "default": 1,
      "description": "\u05d4\u05d3\u05e3 \u05d4\u05d1\u05d0 \u05e9\u05de\u05de\u05e0\u05d5 \u05de\u05de\u05e9\u05d9\u05db\u05d9\u05dd \u05dc\u05e7\u05e8\u05d5\u05d0 \u05d1\u05de\u05d0\u05d2\u05e8 \u2014 \u05db\u05da \u05db\u05dc \u05d4\u05e8\u05e6\u05d4 \u05de\u05de\u05e9\u05d9\u05db\u05d4 \u05dc\u05e2\u05d5\u05de\u05e7"
    },
    "imported": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05d9\u05d5\u05d1\u05d0\u05d5 \u05de\u05d4\u05de\u05d0\u05d2\u05e8 \u05d4\u05d6\u05d4 \u05e2\u05d3 \u05d4\u05d9\u05d5\u05dd"
    },
    "last_run": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d4\u05d4\u05e8\u05e6\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05e9\u05dc \u05d4\u05de\u05d0\u05d2\u05e8 \u05d4\u05d6\u05d4"
    }
  },
  "required": [
    "source"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "PremiumMember",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05de\u05e0\u05d5\u05d9 \u2014 \u05dc\u05e4\u05d9 \u05d6\u05d4 \u05de\u05d6\u05d5\u05d4\u05d4 \u05d4\u05de\u05e0\u05d5\u05d9 \u05d1\u05ea\u05d5\u05da \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4"
    },
    "user_name": {
      "type": "string",
      "default": "",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e0\u05d5\u05d9 \u05dc\u05d4\u05e6\u05d2\u05d4 \u05dc\u05d1\u05e2\u05dc \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4"
    },
    "plan": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "default": "yearly",
      "description": "\u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05e9\u05e0\u05de\u05db\u05e8"
    },
    "paid_until": {
      "type": "string",
      "format": "date",
      "description": "\u05d4\u05de\u05e0\u05d5\u05d9 \u05d1\u05ea\u05d5\u05e7\u05e3 \u05e2\u05d3 \u05d4\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d6\u05d4 (\u05db\u05d5\u05dc\u05dc)"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "\u05d4\u05e1\u05db\u05d5\u05dd \u05e9\u05e0\u05d2\u05d1\u05d4 \u05d1\u05e9\u05e7\u05dc\u05d9\u05dd"
    },
    "payment_method": {
      "type": "string",
      "default": "bit",
      "description": "\u05d0\u05d9\u05da \u05e9\u05d5\u05dc\u05dd: bit / \u05d4\u05e2\u05d1\u05e8\u05d4 / \u05de\u05d6\u05d5\u05de\u05df"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e0\u05d5\u05d9 \u05e4\u05e2\u05d9\u05dc"
    },
    "note": {
      "type": "string",
      "maxLength": 160,
      "default": "",
      "description": "\u05d4\u05e2\u05e8\u05d4 \u05e4\u05e0\u05d9\u05de\u05d9\u05ea \u05e9\u05dc \u05d1\u05e2\u05dc \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
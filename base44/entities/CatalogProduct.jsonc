{
  "name": "CatalogProduct",
  "type": "object",
  "properties": {
    "barcode": {
      "type": "string",
      "description": "\u05d1\u05e8\u05e7\u05d5\u05d3 \u05d4\u05de\u05d5\u05e6\u05e8 \u2014 \u05d4\u05de\u05d6\u05d4\u05d4 \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc\u05d5"
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 \u05db\u05d5\u05dc\u05dc \u05de\u05d5\u05ea\u05d2 \u05d5\u05de\u05d9\u05d3\u05d4"
    },
    "brand": {
      "type": "string",
      "default": "",
      "description": "\u05de\u05d5\u05ea\u05d2 \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "category": {
      "type": "string",
      "default": "\u05d0\u05d7\u05e8",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d1\u05de\u05e1\u05da \u05d4\u05e8\u05e9\u05d9\u05de\u05d4"
    },
    "price": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05d7\u05d9\u05e8 \u05d4\u05de\u05d3\u05e3 \u05d1\u05e9\u05e7\u05dc\u05d9\u05dd \u05d0\u05e6\u05dc \u05d4\u05e8\u05e9\u05ea \u05e9\u05de\u05de\u05e0\u05d4 \u05e0\u05d8\u05e2\u05df"
    },
    "chain": {
      "type": "string",
      "default": "",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05ea (shufersal, rami_levy, ...)"
    },
    "chain_name": {
      "type": "string",
      "default": "",
      "description": "\u05e9\u05dd \u05d4\u05e8\u05e9\u05ea \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea"
    },
    "image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05d4 \u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05d5\u05e6\u05e8 \u05dc\u05e4\u05d9 \u05d4\u05d1\u05e8\u05e7\u05d5\u05d3 \u05e9\u05dc\u05d5"
    },
    "weighted": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 \u05e0\u05de\u05db\u05e8 \u05dc\u05e4\u05d9 \u05de\u05e9\u05e7\u05dc"
    },
    "day": {
      "type": "string",
      "default": "",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05d7\u05d9\u05e8\u05d9\u05dd \u05e9\u05de\u05de\u05e0\u05d5 \u05e0\u05dc\u05e7\u05d7 \u05d4\u05de\u05d5\u05e6\u05e8 (YYYY-MM-DD)"
    },
    "image_checked": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 \u05db\u05d1\u05e8 \u05e0\u05d1\u05d3\u05e7 \u05de\u05d5\u05dc \u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u2014 \u05db\u05d3\u05d9 \u05e9\u05dc\u05d0 \u05d9\u05d9\u05d1\u05d3\u05e7 \u05e9\u05d5\u05d1",
      "default": false
    }
  },
  "required": [
    "barcode",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "PremiumInterest",
  "type": "object",
  "properties": {
    "user_name": {
      "type": "string",
      "default": "",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d4\u05d1\u05d9\u05e2 \u05e2\u05e0\u05d9\u05d9\u05df \u05d1\u05e4\u05e8\u05d9\u05de\u05d9\u05d5\u05dd"
    },
    "email": {
      "type": "string",
      "default": "",
      "description": "\u05d4\u05de\u05d9\u05d9\u05dc \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8 \u05db\u05e9\u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d9\u05d9\u05e4\u05ea\u05d7"
    },
    "plan": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly",
        "unsure"
      ],
      "default": "unsure",
      "description": "\u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05de\u05d1\u05d5\u05e7\u05e9"
    },
    "note": {
      "type": "string",
      "maxLength": 200,
      "default": "",
      "description": "\u05d4\u05e2\u05e8\u05d4 \u05d7\u05d5\u05e4\u05e9\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "source": {
      "type": "string",
      "default": "",
      "description": "\u05de\u05d4\u05d9\u05db\u05df \u05e0\u05e8\u05e9\u05dd \u05d4\u05e2\u05e0\u05d9\u05d9\u05df"
    }
  },
  "required": [
    "plan"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
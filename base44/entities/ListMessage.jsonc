{
  "name": "ListMessage",
  "type": "object",
  "properties": {
    "list_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05d9\u05de\u05d4 \u05e9\u05d4\u05d4\u05d5\u05d3\u05e2\u05d4 \u05e0\u05e9\u05dc\u05d7\u05d4 \u05d1\u05d4"
    },
    "text": {
      "type": "string",
      "maxLength": 240,
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "kind": {
      "type": "string",
      "enum": [
        "message",
        "nudge"
      ],
      "default": "message",
      "description": "\u05d4\u05d5\u05d3\u05e2\u05d4 \u05e8\u05d2\u05d9\u05dc\u05d4 \u05d0\u05d5 \u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05de\u05d4\u05d9\u05e8\u05d4"
    },
    "from_name": {
      "type": "string",
      "default": "",
      "description": "\u05e9\u05dd \u05d4\u05e9\u05d5\u05dc\u05d7"
    },
    "from_email": {
      "type": "string",
      "default": "",
      "description": "\u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05e9\u05d5\u05dc\u05d7 \u2014 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df \u05d4\u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05e9\u05dc\u05d9 \u05dc\u05e9\u05dc \u05d0\u05d7\u05e8\u05d9\u05dd"
    }
  },
  "required": [
    "list_id",
    "text"
  ]
}
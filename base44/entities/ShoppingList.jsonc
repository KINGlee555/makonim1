{
  "name": "ShoppingList",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e8\u05e9\u05d9\u05de\u05d4",
      "maxLength": 64
    },
    "shared_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc\u05d9\u05dd \u05e9\u05dc \u05d0\u05e0\u05e9\u05d9\u05dd \u05e9\u05e9\u05d5\u05ea\u05e4\u05d9\u05dd \u05dc\u05e8\u05e9\u05d9\u05de\u05d4 (\u05e2\u05d3 5)",
      "default": []
    },
    "share_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05e9\u05d9\u05ea\u05d5\u05e3 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05e8\u05e9\u05d9\u05de\u05d4"
    },
    "push_enabled": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea push \u05de\u05d5\u05e4\u05e2\u05dc\u05d5\u05ea \u05dc\u05de\u05e9\u05ea\u05ea\u05e4\u05d9 \u05d4\u05e8\u05e9\u05d9\u05de\u05d4",
      "default": false
    },
    "active_shoppers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e9\u05de\u05d5\u05ea \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05e9\u05db\u05e8\u05d2\u05e2 \u05d1\u05de\u05e6\u05d1 \u05e7\u05e0\u05d9\u05d9\u05d4",
      "default": []
    }
  },
  "required": [
    "title"
  ]
}
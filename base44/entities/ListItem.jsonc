{
  "name": "ListItem",
  "type": "object",
  "properties": {
    "list_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05d9\u05de\u05d4"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8",
      "maxLength": 64
    },
    "barcode": {
      "type": "string",
      "description": "\u05d1\u05e8\u05e7\u05d5\u05d3 \u05d4\u05de\u05d5\u05e6\u05e8 (\u05dc\u05d4\u05e9\u05d5\u05d5\u05d0\u05ea \u05de\u05d7\u05d9\u05e8\u05d9\u05dd \u05d1\u05d9\u05df \u05e8\u05e9\u05ea\u05d5\u05ea)",
      "default": ""
    },
    "image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05d5\u05e6\u05e8 \u05d4\u05d0\u05de\u05d9\u05ea\u05d9\u05ea"
    },
    "price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8: \u05dc\u05d9\u05d7\u05d9\u05d3\u05d4 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc, \u05d5\u05dc\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05de\u05e9\u05e7\u05dc (\u05d2\u05e8\u05dd/\u05e7\u05f4\u05d2) \u05d4\u05de\u05d7\u05d9\u05e8 \u05dc\u05e7\u05f4\u05d2"
    },
    "quantity": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u2014 \u05d1\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea, \u05d5\u05d1\u05d2\u05e8\u05de\u05d9\u05dd/\u05e7\u05f4\u05d2 \u05dc\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05de\u05e9\u05e7\u05dc",
      "default": 1
    },
    "unit": {
      "type": "string",
      "enum": [
        "unit",
        "package",
        "kg",
        "gram",
        "liter"
      ],
      "default": "unit",
      "description": "\u05d9\u05d7\u05d9\u05d3\u05ea \u05de\u05d9\u05d3\u05d4"
    },
    "note": {
      "type": "string",
      "maxLength": 120,
      "default": "",
      "description": "\u05d4\u05e2\u05e8\u05d4 \u05e7\u05e6\u05e8\u05d4 \u05dc\u05de\u05d5\u05e6\u05e8"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "bought",
        "unavailable"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "bought_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05e7\u05e0\u05d4 \u05d0\u05ea \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05de\u05d5\u05e6\u05e8"
    },
    "remind_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05dc\u05d4\u05d6\u05db\u05d9\u05e8 \u05dc\u05e7\u05e0\u05d5\u05ea \u05d0\u05ea \u05d4\u05de\u05d5\u05e6\u05e8 (\u05e8\u05d9\u05e7 = \u05d1\u05dc\u05d9 \u05ea\u05d6\u05db\u05d5\u05e8\u05ea)"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05db\u05d1\u05e8 \u05e0\u05e9\u05dc\u05d7\u05d4"
    },
    "viewed_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u05e9\u05de\u05d5\u05ea \u05d4\u05de\u05e9\u05ea\u05ea\u05e4\u05d9\u05dd \u05e9\u05e4\u05ea\u05d7\u05d5 \u05d0\u05ea \u05d4\u05e8\u05e9\u05d9\u05de\u05d4 \u05d5\u05e8\u05d0\u05d5 \u05d0\u05ea \u05d4\u05de\u05d5\u05e6\u05e8"
    }
  },
  "required": [
    "list_id",
    "name"
  ]
}
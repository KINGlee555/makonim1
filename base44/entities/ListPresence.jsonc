{
  "name": "ListPresence",
  "type": "object",
  "properties": {
    "list_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05d9\u05de\u05d4"
    },
    "user_email": {
      "type": "string",
      "description": "\u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05ea\u05e3 \u05e9\u05e0\u05de\u05e6\u05d0 \u05d1\u05e8\u05e9\u05d9\u05de\u05d4"
    },
    "user_name": {
      "type": "string",
      "default": "",
      "description": "\u05d4\u05e9\u05dd \u05e9\u05de\u05d5\u05e6\u05d2 \u05dc\u05de\u05e9\u05e4\u05d7\u05d4"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d4\u05e4\u05e2\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05e9\u05d4\u05de\u05e9\u05ea\u05ea\u05e3 \u05d4\u05d9\u05d4 \u05d1\u05e8\u05e9\u05d9\u05de\u05d4"
    }
  },
  "required": [
    "list_id",
    "user_email"
  ]
}
{
  "name": "PriceReport",
  "type": "object",
  "properties": {
    "list_id": {
      "type": "string",
      "default": "",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05d9\u05de\u05d4 \u05e9\u05de\u05de\u05e0\u05d4 \u05d3\u05d5\u05d5\u05d7 \u05d4\u05de\u05d7\u05d9\u05e8"
    },
    "item_name": {
      "type": "string",
      "maxLength": 64,
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 \u05e9\u05d3\u05d5\u05d5\u05d7"
    },
    "barcode": {
      "type": "string",
      "default": "",
      "description": "\u05d1\u05e8\u05e7\u05d5\u05d3 \u05d4\u05de\u05d5\u05e6\u05e8 \u2014 \u05db\u05d3\u05d9 \u05dc\u05e2\u05d3\u05db\u05df \u05d0\u05ea \u05db\u05dc \u05d4\u05e8\u05e9\u05d9\u05de\u05d5\u05ea \u05e9\u05de\u05d5\u05db\u05e8\u05d5\u05ea \u05d0\u05d5\u05ea\u05d5"
    },
    "chain_name": {
      "type": "string",
      "default": "",
      "description": "\u05d4\u05e8\u05e9\u05ea \u05e9\u05d1\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e8\u05d0\u05d4 \u05d0\u05ea \u05d4\u05de\u05d7\u05d9\u05e8"
    },
    "shown_price": {
      "type": "number",
      "default": 0,
      "description": "\u05d4\u05de\u05d7\u05d9\u05e8 \u05e9\u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05d4\u05e6\u05d9\u05d2\u05d4 \u05d1\u05d6\u05de\u05df \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7"
    },
    "seen_price": {
      "type": "number",
      "description": "\u05d4\u05de\u05d7\u05d9\u05e8 \u05e9\u05e8\u05d0\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d7\u05e0\u05d5\u05ea"
    },
    "note": {
      "type": "string",
      "maxLength": 160,
      "default": "",
      "description": "\u05d4\u05e2\u05e8\u05d4 \u05d7\u05d5\u05e4\u05e9\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u05de\u05e6\u05d1 \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7"
    },
    "reported_by_name": {
      "type": "string",
      "default": "",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d3\u05d9\u05d5\u05d5\u05d7"
    },
    "review_note": {
      "type": "string",
      "default": "",
      "description": "\u05d4\u05e2\u05e8\u05ea \u05d4\u05de\u05e0\u05d4\u05dc \u05d1\u05e2\u05ea \u05d4\u05d4\u05d7\u05dc\u05d8\u05d4"
    }
  },
  "required": [
    "item_name",
    "seen_price"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "PetSync",
  "type": "object",
  "properties": {
    "store": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d7\u05e0\u05d5\u05ea \u05e9\u05e7\u05d8\u05dc\u05d5\u05d2 \u05d4\u05d7\u05d9\u05d5\u05ea \u05e9\u05dc\u05d4 \u05e0\u05d8\u05e2\u05df"
    },
    "next_page": {
      "type": "number",
      "default": 1,
      "description": "\u05d4\u05d3\u05e3 \u05e9\u05de\u05de\u05e0\u05d5 \u05de\u05de\u05e9\u05d9\u05db\u05d9\u05dd \u05dc\u05e7\u05e8\u05d5\u05d0 \u05d1\u05e8\u05e9\u05ea"
    },
    "published": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05e9\u05d4\u05d7\u05e0\u05d5\u05ea \u05de\u05e4\u05e8\u05e1\u05de\u05ea (0 = \u05dc\u05d0 \u05d9\u05d3\u05d5\u05e2)"
    },
    "done": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05db\u05dc \u05d4\u05e7\u05d8\u05dc\u05d5\u05d2 \u05e9\u05dc \u05d4\u05d7\u05e0\u05d5\u05ea \u05e0\u05d8\u05e2\u05df \u05d1\u05e9\u05dc\u05d5\u05dd"
    },
    "last_run": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d4\u05e4\u05e2\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05e9\u05e7\u05d8\u05dc\u05d5\u05d2 \u05d4\u05d7\u05e0\u05d5\u05ea \u05e0\u05e1\u05e7\u05e8"
    }
  },
  "required": [
    "store"
  ]
}
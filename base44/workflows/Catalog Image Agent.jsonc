{
  "name": "Catalog Image Agent",
  "description": "\u05de\u05e9\u05dc\u05d9\u05dd \u05ea\u05de\u05d5\u05e0\u05d4 \u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05dc\u05db\u05dc \u05de\u05d5\u05e6\u05e8 \u05d1\u05e7\u05d8\u05dc\u05d5\u05d2 \u2014 \u05d7\u05d9\u05e4\u05d5\u05e9 \u05d1\u05d2\u05d5\u05d2\u05dc \u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05d5\u05d1\u05d0\u05ea\u05e8\u05d9 \u05d4\u05e8\u05e9\u05ea\u05d5\u05ea",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * *",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "catalog_image_agent",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "age_restricted_images": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "verifyProductImages",
            "args": {
              "categories": [
                "\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc",
                "\u05e1\u05d9\u05d2\u05e8\u05d9\u05d5\u05ea \u05d5\u05d8\u05d1\u05e7"
              ],
              "limit": 40
            }
          },
          "then": "catalog_images_a",
          "x-base44": {
            "title": "\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc \u05d5\u05e1\u05d9\u05d2\u05e8\u05d9\u05d5\u05ea",
            "description": "\u05ea\u05de\u05d5\u05e0\u05d4 \u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05dc\u05db\u05dc \u05de\u05d5\u05e6\u05e8 18+"
          }
        }
      },
      {
        "catalog_images_a": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "verifyProductImages",
            "args": {
              "limit": 60
            }
          },
          "then": "catalog_images_b",
          "x-base44": {
            "title": "\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05dc\u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05d1\u05dc\u05d9 \u05ea\u05de\u05d5\u05e0\u05d4",
            "description": "\u05e2\u05d3 60 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05d1\u05db\u05dc \u05d1\u05e7\u05e8"
          }
        }
      },
      {
        "catalog_images_b": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "verifyProductImages",
            "args": {
              "limit": 60
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e2\u05d5\u05d3 60 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd",
            "description": "\u05de\u05de\u05e9\u05d9\u05da \u05d1\u05e7\u05d8\u05dc\u05d5\u05d2 \u05de\u05d0\u05d5\u05ea\u05d4 \u05e0\u05e7\u05d5\u05d3\u05d4"
          }
        }
      }
    ]
  }
}
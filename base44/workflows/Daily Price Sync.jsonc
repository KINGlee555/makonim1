{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_price_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_prices": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncPrices",
            "args": {}
          },
          "then": "sync_deals_a",
          "x-base44": {
            "title": "\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05de\u05d7\u05d9\u05e8\u05d9\u05dd \u05d9\u05d5\u05de\u05d9",
            "description": "\u05e2\u05d3\u05db\u05d5\u05df \u05de\u05d7\u05d9\u05e8\u05d9 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05de\u05d4\u05e1\u05d5\u05e4\u05e8\u05d9\u05dd"
          }
        }
      },
      {
        "sync_deals_a": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "chainDeals",
            "args": {
              "mode": "popular",
              "chains": [
                "shufersal",
                "rami_levy",
                "yohananof"
              ]
            }
          },
          "then": "sync_deals_b",
          "x-base44": {
            "title": "\u05de\u05d1\u05e6\u05e2\u05d9\u05dd \u2014 \u05e9\u05d5\u05e4\u05e8\u05e1\u05dc, \u05e8\u05de\u05d9 \u05dc\u05d5\u05d9, \u05d9\u05d5\u05d7\u05e0\u05e0\u05d5\u05e3",
            "description": "\u05e7\u05d5\u05e8\u05d0 \u05d0\u05ea \u05e7\u05d1\u05e6\u05d9 \u05d4\u05de\u05d1\u05e6\u05e2\u05d9\u05dd \u05e9\u05dc \u05e9\u05dc\u05d5\u05e9 \u05d4\u05e8\u05e9\u05ea\u05d5\u05ea \u05d4\u05d2\u05d3\u05d5\u05dc\u05d5\u05ea"
          }
        }
      },
      {
        "sync_deals_b": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "chainDeals",
            "args": {
              "mode": "popular",
              "chains": [
                "osher_ad",
                "tiv_taam",
                "keshet"
              ]
            }
          },
          "then": "sync_deals_c",
          "x-base44": {
            "title": "\u05de\u05d1\u05e6\u05e2\u05d9\u05dd \u2014 \u05d0\u05d5\u05e9\u05e8 \u05e2\u05d3, \u05d8\u05d9\u05d1 \u05d8\u05e2\u05dd, \u05e7\u05e9\u05ea",
            "description": "\u05e7\u05d5\u05e8\u05d0 \u05d0\u05ea \u05e7\u05d1\u05e6\u05d9 \u05d4\u05de\u05d1\u05e6\u05e2\u05d9\u05dd \u05e9\u05dc \u05e9\u05dc\u05d5\u05e9 \u05e8\u05e9\u05ea\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"
          }
        }
      },
      {
        "sync_deals_c": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "chainDeals",
            "args": {
              "mode": "popular",
              "chains": [
                "fresh_market",
                "stop_market",
                "politzer",
                "salach_dabach"
              ]
            }
          },
          "then": "build_catalog_a",
          "x-base44": {
            "title": "\u05de\u05d1\u05e6\u05e2\u05d9\u05dd \u2014 \u05e9\u05d0\u05e8 \u05d4\u05e8\u05e9\u05ea\u05d5\u05ea",
            "description": "\u05e7\u05d5\u05e8\u05d0 \u05d0\u05ea \u05e7\u05d1\u05e6\u05d9 \u05d4\u05de\u05d1\u05e6\u05e2\u05d9\u05dd \u05e9\u05dc \u05e9\u05d0\u05e8 \u05d4\u05e8\u05e9\u05ea\u05d5\u05ea"
          }
        }
      },
      {
        "build_catalog_a": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "buildCatalog",
            "args": {
              "chains": [
                "shufersal",
                "rami_levy",
                "yohananof"
              ],
              "perChain": 2500
            }
          },
          "then": "build_catalog_b",
          "x-base44": {
            "title": "\u05e7\u05d8\u05dc\u05d5\u05d2 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u2014 \u05e9\u05d5\u05e4\u05e8\u05e1\u05dc, \u05e8\u05de\u05d9 \u05dc\u05d5\u05d9, \u05d9\u05d5\u05d7\u05e0\u05e0\u05d5\u05e3",
            "description": "\u05de\u05d5\u05e1\u05d9\u05e3 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd \u05e2\u05dd \u05ea\u05de\u05d5\u05e0\u05d4 \u05de\u05d4\u05e8\u05e9\u05ea\u05d5\u05ea \u05d4\u05d2\u05d3\u05d5\u05dc\u05d5\u05ea"
          }
        }
      },
      {
        "build_catalog_b": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "buildCatalog",
            "args": {
              "chains": [
                "osher_ad",
                "tiv_taam",
                "keshet"
              ],
              "perChain": 2500
            }
          },
          "then": "build_catalog_c",
          "x-base44": {
            "title": "\u05e7\u05d8\u05dc\u05d5\u05d2 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u2014 \u05d0\u05d5\u05e9\u05e8 \u05e2\u05d3, \u05d8\u05d9\u05d1 \u05d8\u05e2\u05dd, \u05e7\u05e9\u05ea",
            "description": "\u05de\u05d5\u05e1\u05d9\u05e3 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd \u05e2\u05dd \u05ea\u05de\u05d5\u05e0\u05d4 \u05de\u05e2\u05d5\u05d3 \u05e9\u05dc\u05d5\u05e9 \u05e8\u05e9\u05ea\u05d5\u05ea"
          }
        }
      },
      {
        "build_catalog_c": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "buildCatalog",
            "args": {
              "chains": [
                "fresh_market",
                "stop_market",
                "politzer",
                "salach_dabach"
              ],
              "perChain": 2500
            }
          },
          "then": "build_catalog_d",
          "x-base44": {
            "title": "\u05e7\u05d8\u05dc\u05d5\u05d2 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u2014 \u05e4\u05e8\u05e9 \u05de\u05e8\u05e7\u05d8, \u05e1\u05d8\u05d5\u05e4 \u05de\u05e8\u05e7\u05d8, \u05e4\u05d5\u05dc\u05d9\u05e6\u05e8, \u05e1\u05d0\u05dc\u05d7 \u05d3\u05d1\u05d0\u05d7",
            "description": "\u05de\u05d5\u05e1\u05d9\u05e3 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd \u05e2\u05dd \u05ea\u05de\u05d5\u05e0\u05d4 \u05de\u05d0\u05e8\u05d1\u05e2 \u05e8\u05e9\u05ea\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"
          }
        }
      },
      {
        "build_catalog_d": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "buildCatalog",
            "args": {
              "chains": [
                "machsanei_hashuk",
                "victory",
                "hazi_hinam"
              ],
              "perChain": 2500
            }
          },
          "then": "build_catalog_e",
          "x-base44": {
            "title": "\u05e7\u05d8\u05dc\u05d5\u05d2 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u2014 \u05de\u05d7\u05e1\u05e0\u05d9 \u05d4\u05e9\u05d5\u05e7, \u05d5\u05d9\u05e7\u05d8\u05d5\u05e8\u05d9, \u05d7\u05e6\u05d9 \u05d7\u05d9\u05e0\u05dd",
            "description": "\u05de\u05d5\u05e1\u05d9\u05e3 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd \u05e2\u05dd \u05ea\u05de\u05d5\u05e0\u05d4 \u05de\u05e2\u05d5\u05d3 \u05e9\u05dc\u05d5\u05e9 \u05e8\u05e9\u05ea\u05d5\u05ea"
          }
        }
      },
      {
        "build_catalog_e": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "buildCatalog",
            "args": {
              "chains": [
                "super_yuda",
                "yeinot_bitan"
              ],
              "perChain": 2500
            }
          },
          "then": "fill_images",
          "x-base44": {
            "title": "\u05e7\u05d8\u05dc\u05d5\u05d2 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u2014 \u05e1\u05d5\u05e4\u05e8 \u05d9\u05d5\u05d3\u05d4, \u05d9\u05d9\u05e0\u05d5\u05ea \u05d1\u05d9\u05ea\u05df",
            "description": "\u05de\u05d5\u05e1\u05d9\u05e3 \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd \u05e2\u05dd \u05ea\u05de\u05d5\u05e0\u05d4 \u05de\u05e9\u05ea\u05d9 \u05e8\u05e9\u05ea\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"
          }
        }
      },
      {
        "fill_images": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "fillProductImages",
            "args": {
              "limit": 1200,
              "nameBudget": 20,
              "items": 40
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05dc\u05db\u05dc \u05d4\u05de\u05d5\u05e6\u05e8\u05d9\u05dd",
            "description": "\u05de\u05e9\u05dc\u05d9\u05dd \u05ea\u05de\u05d5\u05e0\u05d4 \u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05de\u05d4\u05e8\u05e9\u05ea\u05d5\u05ea \u05dc\u05db\u05dc \u05de\u05d5\u05e6\u05e8 \u05d1\u05e7\u05d8\u05dc\u05d5\u05d2 \u05e9\u05d0\u05d9\u05df \u05dc\u05d5 \u05ea\u05de\u05d5\u05e0\u05d4"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Syncs product prices and chain promotions every day at 7 AM",
  "name": "Daily Price Sync"
}
  "name": "Product Images Coverage",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "product_images_coverage",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "fill_product_images": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "fillProductImages",
            "args": {
              "limit": 900,
              "nameBudget": 20,
              "items": 40
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05dc\u05db\u05dc \u05d4\u05de\u05d5\u05e6\u05e8\u05d9\u05dd"
          }
        }
      }
    ]
  },
  "description": "\u05e8\u05e5 \u05db\u05dc \u05e9\u05e2\u05d4 \u05d5\u05de\u05e9\u05dc\u05d9\u05dd \u05ea\u05de\u05d5\u05e0\u05d4 \u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05de\u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05dc\u05db\u05dc \u05de\u05d5\u05e6\u05e8 \u05d1\u05e7\u05d8\u05dc\u05d5\u05d2 \u05e9\u05d0\u05d9\u05df \u05dc\u05d5 \u05ea\u05de\u05d5\u05e0\u05d4 \u2014 \u05dc\u05e4\u05d9 \u05d1\u05e8\u05e7\u05d5\u05d3 \u05de\u05d5\u05dc \u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05d4\u05e8\u05e9\u05ea, \u05dc\u05e4\u05d9 \u05d4\u05de\u05d0\u05d2\u05e8 \u05d4\u05e4\u05ea\u05d5\u05d7, \u05d5\u05d0\u05dd \u05e6\u05e8\u05d9\u05da \u05d2\u05dd \u05dc\u05e4\u05d9 \u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8."
}